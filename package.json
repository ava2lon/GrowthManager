{
  "name": "growthmanager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:status": "prisma migrate status",
    "test:integration": "vitest run --config vitest.integration.config.ts src/lib/tenant-isolation.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.30",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.5.6",
    "postcss": "^8.5.6",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "@eslint/eslintrc": "^3.3.1",
    "vitest": "3.2.4"
  }
}
