# Supabase transaction pooler (port 6543) for Prisma runtime queries.
# Replace POOLER_HOST with the pooler host shown in Supabase Database settings.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase session pooler (port 5432) for Prisma migrations/direct connections.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Transactional workspace invitation email (Resend; use a verified sender domain).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="GrowthManager <invites@your-verified-domain.com>"

# Required in production: distributed authentication and registration rate limits.
UPSTASH_REDIS_REST_URL="https://YOUR-DATABASE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-rest-token"

# AES-256-GCM key for integration credentials. Generate with:
# openssl rand -base64 32
# Keep this key in a secret manager; never commit a real key.
INTEGRATION_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
INTEGRATION_ENCRYPTION_KEY_ID="primary"

# Optional during rotation: retain the old key until all credentials are re-encrypted.
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=""
INTEGRATION_ENCRYPTION_KEY_PREVIOUS_ID=""

# Optional exact host allowlist for self-hosted n8n instances.
# Comma-separated hostnames only (no scheme, port, path, or wildcard).
# n8n Cloud *.app.n8n.cloud hostnames are allowed by default.
N8N_ALLOWED_HOSTS=""

# Optional exact host allowlist for self-hosted n8n instances.
# Comma-separated hostnames only (no scheme, port, path, or wildcard).
# n8n Cloud *.app.n8n.cloud hostnames are allowed by default.
N8N_ALLOWED_HOSTS=""

# Protect scheduled automation alert evaluation (generate a random secret of at least 32 bytes).
CRON_SECRET="replace-with-a-long-random-secret"

# Private Supabase Storage bucket for workspace media assets.
# Create a PRIVATE bucket named growthmanager-media in Supabase Storage.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_MEDIA_BUCKET="growthmanager-media"

# TikTok Login Kit / Content Posting API (creator inbox upload).
# Register this exact HTTPS callback URI in TikTok Developer Portal:
# https://growthmanager.vercel.app/api/integrations/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://growthmanager.vercel.app/api/integrations/tiktok/callback"

# YouTube Data API v3 OAuth. Register this exact callback URI in Google Cloud:
# https://growthmanager.vercel.app/api/integrations/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="https://growthmanager.vercel.app/api/integrations/youtube/callback"

# LinkedIn OAuth and versioned API
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://growthmanager.vercel.app/api/integrations/linkedin/callback"
LINKEDIN_API_VERSION="202610"
LINKEDIN_ENABLE_ORGANIZATION_SCOPES="false"
# Request rw_organization_admin only after Community Management API analytics access is approved.
LINKEDIN_ENABLE_ORGANIZATION_ANALYTICS_SCOPE="false"

# Pinterest API v5 OAuth. Register this exact HTTPS callback URI:
# https://growthmanager.vercel.app/api/integrations/pinterest/callback
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_REDIRECT_URI="https://growthmanager.vercel.app/api/integrations/pinterest/callback"


# Meta Graph API (Facebook Pages + Instagram professional accounts).
# Use a Graph API version currently supported by your Meta app.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://growthmanager.vercel.app/api/integrations/meta/callback"
META_GRAPH_API_VERSION="v26.0"

# Opt in only after TikTok approves Display API access for this app.
# Requests video.list and user.info.stats during TikTok OAuth reauthorization.
TIKTOK_ENABLE_ANALYTICS_SCOPE=false

# Enable only after YouTube Analytics API is enabled and OAuth consent is configured.
# Existing channels must reconnect to grant yt-analytics.readonly.
YOUTUBE_ENABLE_ANALYTICS_SCOPE=false
