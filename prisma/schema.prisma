generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum BrandStatus {
  ACTIVE
  ARCHIVED
}
enum SocialProvider {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
  SNAPCHAT
  REDDIT
  TELEGRAM
}
enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}
enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

model User {
  id           String                @id @default(cuid())
  name         String?
  email        String                @unique
  passwordHash String
  image        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  activityLogs ActivityLog[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
}

model Workspace {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  brands       Brand[]
  campaigns    Campaign[]
  tasks        Task[]
  integrations Integration[]
  automations  Automation[]
  activityLogs ActivityLog[]
  invitations  WorkspaceInvitation[]
  automationAlertPolicy AutomationAlertPolicy?
  automationAlertEvents AutomationAlertEvent[]
  mediaAssets MediaAsset[]
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  @@index([workspaceId, email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Brand {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  websiteUrl     String?
  status         BrandStatus    @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]
  posts          ContentPost[]
  campaigns      Campaign[]
  mediaAssets    MediaAsset[]
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

model SocialAccount {
  id             String         @id @default(cuid())
  workspaceId    String
  brandId        String
  provider       SocialProvider
  providerUserId String?
  accountName    String
  credentialsEncrypted String?   @db.Text
  status         String         @default("DISCONNECTED")
  scopes         String[]       @default([])
  tokenExpiresAt DateTime?
  connectedAt    DateTime?
  lastValidatedAt DateTime?
  lastErrorCode  String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  brand          Brand          @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  publishTargets SocialPostTarget[]
  pinterestAnalyticsSnapshots PinterestAnalyticsSnapshot[]
  metaAnalyticsSnapshots MetaAnalyticsSnapshot[]
  @@unique([workspaceId, provider, providerUserId])
  @@unique([workspaceId, id])
  @@index([workspaceId, brandId, provider])
  @@index([workspaceId, provider, status])
}

model ContentPost {
  id          String     @id @default(cuid())
  workspaceId String
  brandId     String
  title       String?
  body        String
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brand       Brand      @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  publishTargets SocialPostTarget[]
  mediaAssets ContentPostMedia[]
  @@unique([workspaceId, id])
  @@index([workspaceId, brandId, status, scheduledAt])
}

model SocialPostTarget {
  id             String   @id @default(cuid())
  workspaceId    String
  contentPostId  String
  socialAccountId String
  provider       SocialProvider
  status         String   @default("DRAFT")
  providerPostId String?
  providerContainerId String?
  uploadSessionEncrypted String? @db.Text
  uploadOffset BigInt?
  uploadTotalBytes BigInt?
  uploadMetadata Json?
  processingStartedAt DateTime?
  nextCheckAt DateTime?
  errorCode      String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contentPost    ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  socialAccount  SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  attempts       SocialPublishAttempt[]
  pinterestAnalyticsSnapshots PinterestPinAnalyticsSnapshot[]
  metaAnalyticsSnapshots MetaAnalyticsSnapshot[]
  @@unique([workspaceId, id])
  @@unique([contentPostId, socialAccountId])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, socialAccountId, status])
}

model SocialPublishAttempt {
  id             String   @id @default(cuid())
  workspaceId    String
  targetId       String
  attemptNumber  Int
  idempotencyKey String   @unique
  status         String
  providerPostId String?
  errorCode      String?
  httpStatus     Int?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  target         SocialPostTarget @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([targetId, attemptNumber])
  @@index([workspaceId, startedAt])
}

model MediaAsset {
  id               String           @id @default(cuid())
  workspaceId      String
  brandId          String?
  createdById      String
  storageProvider  String           @default("SUPABASE")
  bucket           String
  objectPath       String
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  checksumSha256   String?
  width            Int?
  height           Int?
  durationMs       Int?
  altText          String?
  status           MediaAssetStatus @default(PENDING)
  uploadedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand?           @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  postAttachments ContentPostMedia[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, objectPath])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, brandId, createdAt])
}

model ContentPostMedia {
  id            String      @id @default(cuid())
  workspaceId   String
  contentPostId String
  mediaAssetId  String
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  contentPost   ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  mediaAsset    MediaAsset  @relation(fields: [workspaceId, mediaAssetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, contentPostId, mediaAssetId])
  @@unique([workspaceId, contentPostId, position])
  @@index([workspaceId, mediaAssetId])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  objective   String?
  status      CampaignStatus @default(PLANNING)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?         @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  @@index([workspaceId, status])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  name        String
  status      String    @default("DISCONNECTED")
  credentialsEncrypted String? @db.Text
  lastValidatedAt DateTime?
  lastErrorAt DateTime?
  lastErrorCode String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationAlertEvents AutomationAlertEvent[]
  automationAlertDeliveries AutomationAlertDelivery[]
  resendWebhookEvents ResendWebhookEvent[]
  @@unique([workspaceId, provider])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, updatedAt])
}

model Automation {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean   @default(false)
  definition  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, enabled])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  description String?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, dueAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
}


model AutomationAlertPolicy {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  enabled               Boolean   @default(true)
  failureCountThreshold Int       @default(3)
  failureRateThreshold  Float     @default(10)
  lookbackMinutes       Int       @default(1440)
  cooldownMinutes       Int       @default(60)
  emailNotificationsEnabled Boolean @default(false)
  notificationEmail     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AutomationAlertEvent {
  id                String    @id @default(cuid())
  workspaceId       String
  integrationId     String
  provider          String    @default("n8n")
  alertType         String
  severity          String    @default("WARNING")
  dedupeKey         String
  message           String
  observedCount     Int
  observedRate      Float
  sampleSize        Int
  status            String    @default("OPEN")
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  lastNotifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  deliveries        AutomationAlertDelivery[]
  @@unique([workspaceId, dedupeKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, integrationId, createdAt])
}


model AutomationAlertDelivery {
  id                String   @id @default(cuid())
  workspaceId       String
  alertEventId      String
  integrationId     String
  channel           String   @default("EMAIL")
  recipient         String
  status            String   @default("PENDING")
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastProviderEventAt DateTime?
  lastErrorCode     String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  alertEvent        AutomationAlertEvent @relation(fields: [workspaceId, alertEventId], references: [workspaceId, id], onDelete: Cascade)
  attemptRecords    AutomationAlertDeliveryAttempt[]
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, id])
  @@unique([workspaceId, alertEventId, channel, recipient])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@index([providerMessageId])
}

model ResendWebhookEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  integrationId   String
  providerEventId String
  eventType       String
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  integration     Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([integrationId, providerEventId])
  @@index([workspaceId, receivedAt])
}

model AutomationAlertDeliveryAttempt {
  id                String   @id @default(cuid())
  workspaceId       String
  deliveryId        String
  attemptNumber     Int
  status            String
  providerMessageId String?
  errorCode         String?
  httpStatus        Int?
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  delivery          AutomationAlertDelivery @relation(fields: [workspaceId, deliveryId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([deliveryId, attemptNumber])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, deliveryId, attemptNumber])
}


model PinterestAnalyticsSnapshot {
  id              String        @id @default(cuid())
  workspaceId     String
  socialAccountId String
  reportDate      DateTime      @db.Date
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  metrics         Json
  rawResponse     Json
  fetchedAt       DateTime      @default(now())
  socialAccount   SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, reportDate])
  @@index([workspaceId, reportDate])
  @@index([workspaceId, socialAccountId, fetchedAt])
}


model PinterestPinAnalyticsSnapshot {
  id              String          @id @default(cuid())
  workspaceId     String
  targetId        String
  pinId           String
  reportDate      DateTime        @db.Date
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  metrics         Json
  rawResponse     Json
  fetchedAt       DateTime        @default(now())
  target          SocialPostTarget @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, targetId, reportDate])
  @@index([workspaceId, reportDate])
  @@index([workspaceId, targetId, fetchedAt])
}


model MetaAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  target SocialPostTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, subjectType, subjectId, reportDate], map: "meta_analytics_subject_report_uq")
  @@index([workspaceId, reportDate], map: "meta_analytics_workspace_date_idx")
  @@index([workspaceId, socialAccountId, subjectType, fetchedAt], map: "meta_analytics_account_type_fetched_idx")
  @@index([targetId], map: "meta_analytics_target_idx")
}
