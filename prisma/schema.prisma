generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum BrandStatus {
  ACTIVE
  ARCHIVED
}
enum SocialProvider {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  PINTEREST
}
enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}
enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id           String                @id @default(cuid())
  name         String?
  email        String                @unique
  passwordHash String
  image        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  activityLogs ActivityLog[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
}

model Workspace {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  brands       Brand[]
  campaigns    Campaign[]
  tasks        Task[]
  integrations Integration[]
  automations  Automation[]
  activityLogs ActivityLog[]
  invitations  WorkspaceInvitation[]
  automationAlertPolicy AutomationAlertPolicy?
  automationAlertEvents AutomationAlertEvent[]
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  @@index([workspaceId, email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Brand {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  websiteUrl     String?
  status         BrandStatus    @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]
  posts          ContentPost[]
  campaigns      Campaign[]
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

model SocialAccount {
  id             String         @id @default(cuid())
  workspaceId    String
  brandId        String
  provider       SocialProvider
  providerUserId String?
  accountName    String
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  brand          Brand          @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  @@index([workspaceId, brandId, provider])
}

model ContentPost {
  id          String     @id @default(cuid())
  workspaceId String
  brandId     String
  title       String?
  body        String
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brand       Brand      @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  @@index([workspaceId, brandId, status, scheduledAt])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  objective   String?
  status      CampaignStatus @default(PLANNING)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?         @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  @@index([workspaceId, status])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  name        String
  status      String    @default("DISCONNECTED")
  credentialsEncrypted String? @db.Text
  lastValidatedAt DateTime?
  lastErrorAt DateTime?
  lastErrorCode String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationAlertEvents AutomationAlertEvent[]
  automationAlertDeliveries AutomationAlertDelivery[]
  @@unique([workspaceId, provider])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, updatedAt])
}

model Automation {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean   @default(false)
  definition  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, enabled])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  description String?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, dueAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
}


model AutomationAlertPolicy {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  enabled               Boolean   @default(true)
  failureCountThreshold Int       @default(3)
  failureRateThreshold  Float     @default(10)
  lookbackMinutes       Int       @default(1440)
  cooldownMinutes       Int       @default(60)
  emailNotificationsEnabled Boolean @default(false)
  notificationEmail     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AutomationAlertEvent {
  id                String    @id @default(cuid())
  workspaceId       String
  integrationId     String
  provider          String    @default("n8n")
  alertType         String
  severity          String    @default("WARNING")
  dedupeKey         String
  message           String
  observedCount     Int
  observedRate      Float
  sampleSize        Int
  status            String    @default("OPEN")
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  lastNotifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  deliveries        AutomationAlertDelivery[]
  @@unique([workspaceId, dedupeKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, integrationId, createdAt])
}


model AutomationAlertDelivery {
  id                String   @id @default(cuid())
  workspaceId       String
  alertEventId      String
  integrationId     String
  channel           String   @default("EMAIL")
  recipient         String
  status            String   @default("PENDING")
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastErrorCode     String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  alertEvent        AutomationAlertEvent @relation(fields: [workspaceId, alertEventId], references: [workspaceId, id], onDelete: Cascade)
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, alertEventId, channel, recipient])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
}
