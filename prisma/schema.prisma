generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum BrandStatus {
  ACTIVE
  ARCHIVED
}
enum SocialProvider {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
  SNAPCHAT
  REDDIT
  TELEGRAM
}
enum PostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}
enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum WorkspaceNotificationType {
  CONTENT_REVIEW_ASSIGNED
  CONTENT_REVIEW_COMPLETED
  CONTENT_CHANGES_REQUESTED
  SOCIAL_INCIDENT
  SOCIAL_INCIDENT_RESOLVED
  SOCIAL_INCIDENT_ESCALATED
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

model User {
  id           String                @id @default(cuid())
  name         String?
  email        String                @unique
  passwordHash String
  image        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  activityLogs ActivityLog[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  assignedContentReviews ContentReviewAssignment[] @relation("ContentReviewAssignee")
  createdContentReviews ContentReviewAssignment[] @relation("ContentReviewAssigner")
  workspaceNotifications WorkspaceNotification[]
  notificationPreferences WorkspaceNotificationPreference[]
  contentReviewEmailDeliveries ContentReviewEmailDelivery[]
  contentReviewEmailDigests ContentReviewEmailDigest[]
  socialIncidentEmailDeliveries WorkspaceIncidentEmailDelivery[]
  socialAnalyticsRetries SocialAnalyticsRetry[]
}

model Workspace {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  brands       Brand[]
  campaigns    Campaign[]
  tasks        Task[]
  integrations Integration[]
  automations  Automation[]
  activityLogs ActivityLog[]
  invitations  WorkspaceInvitation[]
  automationAlertPolicy AutomationAlertPolicy?
  automationAlertEvents AutomationAlertEvent[]
  mediaAssets MediaAsset[]
  contentReviewAssignments ContentReviewAssignment[]
  notifications WorkspaceNotification[]
  contentReviewEmailDeliveries ContentReviewEmailDelivery[]
  contentReviewEmailDigests ContentReviewEmailDigest[]
  notificationPreferences WorkspaceNotificationPreference[]
  incidents WorkspaceIncident[]
  socialIncidentEmailDeliveries WorkspaceIncidentEmailDelivery[]
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  @@index([workspaceId, email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Brand {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  websiteUrl     String?
  status         BrandStatus    @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]
  posts          ContentPost[]
  campaigns      Campaign[]
  mediaAssets    MediaAsset[]
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

model SocialAccount {
  id             String         @id @default(cuid())
  workspaceId    String
  brandId        String
  provider       SocialProvider
  providerUserId String?
  accountName    String
  credentialsEncrypted String?   @db.Text
  status         String         @default("DISCONNECTED")
  scopes         String[]       @default([])
  tokenExpiresAt DateTime?
  connectedAt    DateTime?
  lastValidatedAt DateTime?
  lastErrorCode  String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  brand          Brand          @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  publishTargets SocialPostTarget[]
  pinterestAnalyticsSnapshots PinterestAnalyticsSnapshot[]
  metaAnalyticsSnapshots MetaAnalyticsSnapshot[]
  linkedinAnalyticsSnapshots LinkedInAnalyticsSnapshot[]
  tikTokAnalyticsSnapshots TikTokAnalyticsSnapshot[]
  youTubeAnalyticsSnapshots YouTubeAnalyticsSnapshot[]
  xAnalyticsSnapshots XAnalyticsSnapshot[]
  incidents WorkspaceIncident[]
  @@unique([workspaceId, provider, providerUserId])
  @@unique([workspaceId, id])
  @@index([workspaceId, brandId, provider])
  @@index([workspaceId, provider, status])
}

model ContentPost {
  id          String     @id @default(cuid())
  workspaceId String
  brandId     String
  title       String?
  body        String
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brand       Brand      @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  publishTargets SocialPostTarget[]
  mediaAssets ContentPostMedia[]
  revisions ContentPostRevision[]
  reviewAssignments ContentReviewAssignment[]
  @@unique([workspaceId, id])
  @@index([workspaceId, brandId, status, scheduledAt])
}

model ContentPostRevision {
  id            String      @id @default(cuid())
  workspaceId   String
  contentPostId String
  title         String?
  body          String
  version       Int
  changeReason  String?
  createdById   String?
  createdAt     DateTime    @default(now())
  contentPost   ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([contentPostId, version])
  @@index([workspaceId, contentPostId, createdAt])
}

model ContentReviewAssignment {
  id             String              @id @default(cuid())
  workspaceId    String
  contentPostId  String
  reviewerUserId String
  assignedById   String
  status         ContentReviewStatus @default(PENDING)
  feedback       String?             @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPost    ContentPost         @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  reviewer       User                @relation("ContentReviewAssignee", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  assignedBy     User                @relation("ContentReviewAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  @@unique([workspaceId, contentPostId, reviewerUserId])
  @@unique([workspaceId, id])
  @@index([workspaceId, reviewerUserId, status, updatedAt])
  @@index([workspaceId, contentPostId, status])
  emailDeliveries ContentReviewEmailDelivery[]
}

model WorkspaceNotification {
  id          String                    @id @default(cuid())
  workspaceId String
  userId      String
  type        WorkspaceNotificationType
  title       String
  message     String                    @db.Text
  href        String
  readAt      DateTime?
  createdAt   DateTime                  @default(now())
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([workspaceId, userId, readAt, createdAt])
}

model SocialPostTarget {
  id             String   @id @default(cuid())
  workspaceId    String
  contentPostId  String
  socialAccountId String
  provider       SocialProvider
  status         String   @default("DRAFT")
  providerPostId String?
  providerContainerId String?
  uploadSessionEncrypted String? @db.Text
  uploadOffset BigInt?
  uploadTotalBytes BigInt?
  uploadMetadata Json?
  processingStartedAt DateTime?
  nextCheckAt DateTime?
  errorCode      String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contentPost    ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  socialAccount  SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  attempts       SocialPublishAttempt[]
  incidents WorkspaceIncident[]
  pinterestAnalyticsSnapshots PinterestPinAnalyticsSnapshot[]
  metaAnalyticsSnapshots MetaAnalyticsSnapshot[]
  linkedinAnalyticsSnapshots LinkedInAnalyticsSnapshot[]
  tikTokAnalyticsSnapshots TikTokAnalyticsSnapshot[]
  youTubeAnalyticsSnapshots YouTubeAnalyticsSnapshot[]
  xAnalyticsSnapshots XAnalyticsSnapshot[]
  @@unique([workspaceId, id])
  @@unique([contentPostId, socialAccountId])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, socialAccountId, status])
}

model SocialPublishAttempt {
  id             String   @id @default(cuid())
  workspaceId    String
  targetId       String
  attemptNumber  Int
  idempotencyKey String   @unique
  status         String
  providerPostId String?
  errorCode      String?
  httpStatus     Int?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  target         SocialPostTarget @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([targetId, attemptNumber])
  @@index([workspaceId, startedAt])
}

model MediaAsset {
  id               String           @id @default(cuid())
  workspaceId      String
  brandId          String?
  createdById      String
  storageProvider  String           @default("SUPABASE")
  bucket           String
  objectPath       String
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  checksumSha256   String?
  width            Int?
  height           Int?
  durationMs       Int?
  altText          String?
  status           MediaAssetStatus @default(PENDING)
  uploadedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand?           @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  postAttachments ContentPostMedia[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, objectPath])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, brandId, createdAt])
}

model ContentPostMedia {
  id            String      @id @default(cuid())
  workspaceId   String
  contentPostId String
  mediaAssetId  String
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  contentPost   ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  mediaAsset    MediaAsset  @relation(fields: [workspaceId, mediaAssetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, contentPostId, mediaAssetId])
  @@unique([workspaceId, contentPostId, position])
  @@index([workspaceId, mediaAssetId])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  objective   String?
  status      CampaignStatus @default(PLANNING)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?         @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  @@index([workspaceId, status])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  name        String
  status      String    @default("DISCONNECTED")
  credentialsEncrypted String? @db.Text
  lastValidatedAt DateTime?
  lastExecutionSyncAt DateTime?
  lastExecutionSyncCursor String? @db.Text
  lastErrorAt DateTime?
  lastErrorCode String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationAlertEvents AutomationAlertEvent[]
  automationAlertDeliveries AutomationAlertDelivery[]
  resendWebhookEvents ResendWebhookEvent[]
  n8nExecutionSnapshots N8nExecutionSnapshot[]
  @@unique([workspaceId, provider])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, updatedAt])
  @@index([provider, status, lastExecutionSyncAt])
}

model N8nExecutionSnapshot {
  id            String      @id @default(cuid())
  workspaceId   String
  integrationId String
  executionId   String
  workflowId    String
  status        String
  mode          String
  startedAt     DateTime?
  stoppedAt     DateTime?
  waitTill      DateTime?
  retryOf       String?
  retrySuccessId String?
  syncedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  integration   Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, integrationId, executionId])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, integrationId, status, startedAt])
  @@index([workspaceId, workflowId, startedAt])
}

model Automation {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean   @default(false)
  definition  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, enabled])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  description String?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, dueAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
}


model AutomationAlertPolicy {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  enabled               Boolean   @default(true)
  failureCountThreshold Int       @default(3)
  failureRateThreshold  Float     @default(10)
  lookbackMinutes       Int       @default(1440)
  cooldownMinutes       Int       @default(60)
  emailNotificationsEnabled Boolean @default(false)
  notificationEmail     String?
  lastEvaluatedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([enabled, lastEvaluatedAt])
}

model AutomationAlertEvent {
  id                String    @id @default(cuid())
  workspaceId       String
  integrationId     String
  provider          String    @default("n8n")
  alertType         String
  severity          String    @default("WARNING")
  dedupeKey         String
  message           String
  observedCount     Int
  observedRate      Float
  sampleSize        Int
  status            String    @default("OPEN")
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  lastNotifiedAt    DateTime?
  resolvedAt        DateTime?
  resolutionMessage String?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  deliveries        AutomationAlertDelivery[]
  @@unique([workspaceId, dedupeKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, integrationId, createdAt])
}


model AutomationAlertDelivery {
  id                String   @id @default(cuid())
  workspaceId       String
  alertEventId      String
  integrationId     String
  channel           String   @default("EMAIL")
  recipient         String
  status            String   @default("PENDING")
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastProviderEventAt DateTime?
  lastErrorCode     String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  alertEvent        AutomationAlertEvent @relation(fields: [workspaceId, alertEventId], references: [workspaceId, id], onDelete: Cascade)
  attemptRecords    AutomationAlertDeliveryAttempt[]
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, id])
  @@unique([workspaceId, alertEventId, channel, recipient])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@index([providerMessageId])
}

model ResendWebhookEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  integrationId   String
  providerEventId String
  eventType       String
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  integration     Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([integrationId, providerEventId])
  @@index([workspaceId, receivedAt])
}

model AutomationAlertDeliveryAttempt {
  id                String   @id @default(cuid())
  workspaceId       String
  deliveryId        String
  attemptNumber     Int
  status            String
  providerMessageId String?
  errorCode         String?
  httpStatus        Int?
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  delivery          AutomationAlertDelivery @relation(fields: [workspaceId, deliveryId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([deliveryId, attemptNumber])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, deliveryId, attemptNumber])
}


model PinterestAnalyticsSnapshot {
  id              String        @id @default(cuid())
  workspaceId     String
  socialAccountId String
  reportDate      DateTime      @db.Date
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  metrics         Json
  rawResponse     Json
  fetchedAt       DateTime      @default(now())
  socialAccount   SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, reportDate])
  @@index([workspaceId, reportDate])
  @@index([workspaceId, socialAccountId, fetchedAt])
}


model PinterestPinAnalyticsSnapshot {
  id              String          @id @default(cuid())
  workspaceId     String
  targetId        String
  pinId           String
  reportDate      DateTime        @db.Date
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  metrics         Json
  rawResponse     Json
  fetchedAt       DateTime        @default(now())
  target          SocialPostTarget @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, targetId, reportDate])
  @@index([workspaceId, reportDate])
  @@index([workspaceId, targetId, fetchedAt])
}


model MetaAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  target SocialPostTarget? @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, subjectType, subjectId, reportDate], map: "meta_analytics_subject_report_uq")
  @@index([workspaceId, reportDate], map: "meta_analytics_workspace_date_idx")
  @@index([workspaceId, socialAccountId, subjectType, fetchedAt], map: "meta_analytics_account_type_fetched_idx")
  @@index([targetId], map: "meta_analytics_target_idx")
}


model LinkedInAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  target SocialPostTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, subjectType, subjectId, reportDate], map: "linkedin_analytics_subject_report_uq")
  @@index([workspaceId, reportDate], map: "linkedin_analytics_workspace_date_idx")
  @@index([workspaceId, socialAccountId, subjectType, fetchedAt], map: "linkedin_analytics_account_type_fetched_idx")
  @@index([targetId], map: "linkedin_analytics_target_idx")
}




model YouTubeAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  target SocialPostTarget? @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, subjectType, subjectId, reportDate], map: "youtube_analytics_subject_report_uq")
  @@index([workspaceId, reportDate], map: "youtube_analytics_workspace_date_idx")
  @@index([workspaceId, socialAccountId, subjectType, fetchedAt], map: "youtube_analytics_account_type_fetched_idx")
  @@index([targetId], map: "youtube_analytics_target_idx")
}

model TikTokAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  target SocialPostTarget? @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, subjectType, subjectId, reportDate], map: "tiktok_analytics_subject_report_uq")
  @@index([workspaceId, reportDate], map: "tiktok_analytics_workspace_date_idx")
  @@index([workspaceId, socialAccountId, subjectType, fetchedAt], map: "tiktok_analytics_account_type_fetched_idx")
  @@index([targetId], map: "tiktok_analytics_target_idx")
}


model XAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  target SocialPostTarget? @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, subjectType, subjectId, reportDate], map: "x_analytics_subject_report_uq")
  @@index([workspaceId, reportDate], map: "x_analytics_workspace_date_idx")
  @@index([workspaceId, socialAccountId, subjectType, fetchedAt], map: "x_analytics_account_type_fetched_idx")
  @@index([targetId], map: "x_analytics_target_idx")
}


model ContentReviewEmailDelivery {
  id                String                    @id @default(cuid())
  workspaceId       String
  assignmentId      String
  eventType         WorkspaceNotificationType
  eventKey          String                    @unique
  recipientEmail    String
  recipientUserId   String?
  recipientName     String?
  status            String                    @default("PENDING")
  attempts          Int                       @default(0)
  nextAttemptAt     DateTime                  @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastErrorCode     String?
  sentAt            DateTime?
  lastProviderEventAt DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignment        ContentReviewAssignment   @relation(fields: [workspaceId, assignmentId], references: [workspaceId, id], onDelete: Cascade)
  recipient         User?                     @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  webhookEvents     ContentReviewEmailWebhookEvent[]
  @@unique([workspaceId, id])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@index([providerMessageId])
}


model ContentReviewEmailWebhookEvent {
  id              String                    @id @default(cuid())
  deliveryId      String
  providerEventId String                    @unique
  eventType       String
  occurredAt      DateTime
  receivedAt      DateTime                  @default(now())
  delivery        ContentReviewEmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@index([deliveryId, occurredAt])
}


model WorkspaceNotificationPreference {
  id                       String    @id @default(cuid())
  workspaceId              String
  userId                   String
  inAppReviewAssigned       Boolean   @default(true)
  emailReviewAssigned      Boolean   @default(true)
  inAppReviewDecisions      Boolean   @default(true)
  emailReviewDecisions     Boolean   @default(true)
  timezone                 String    @default("UTC")
  quietHoursEnabled        Boolean   @default(false)
  quietHoursStart          String    @default("22:00")
  quietHoursEnd            String    @default("08:00")
  inAppSocialIncidents     Boolean   @default(true)
  emailSocialIncidents     Boolean   @default(false)
  digestEnabled            Boolean   @default(false)
  digestFrequency          String    @default("DAILY")
  digestSendTime           String    @default("09:00")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId, updatedAt])
}


model ContentReviewEmailDigest {
  id                String   @id @default(cuid())
  workspaceId       String
  recipientUserId   String
  recipientEmail    String
  recipientName     String?
  digestKey         String   @unique
  periodKey         String
  deliveryIds       String[]
  items             Json
  status            String   @default("PENDING")
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastErrorCode     String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient         User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  @@index([status, nextAttemptAt])
  @@index([workspaceId, recipientUserId, createdAt])
}


model WorkspaceIncident {
  id                 String   @id @default(cuid())
  workspaceId        String
  sourceType         String
  sourceId           String
  socialAccountId    String?
  socialPostTargetId String?
  category           String
  severity           String
  status             String   @default("OPEN")
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  dedupeKey          String
  message            String   @db.Text
  errorCode          String?
  occurrenceCount   Int      @default(1)
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  resolvedAt         DateTime?
  escalatedAt        DateTime?
  resolutionMessage  String?  @db.Text
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount? @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  socialPostTarget   SocialPostTarget? @relation(fields: [workspaceId, socialPostTargetId], references: [workspaceId, id], onDelete: Cascade)
  emailDeliveries      WorkspaceIncidentEmailDelivery[]
  @@unique([workspaceId, dedupeKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, severity, lastSeenAt])
  @@index([workspaceId, sourceType, sourceId])
  @@index([status, lastSeenAt])
}


model WorkspaceIncidentEmailDelivery {
  id                  String   @id @default(cuid())
  workspaceId         String
  incidentId          String
  recipientUserId     String
  recipientEmail      String
  incidentOccurrence  Int
  eventType           String
  status              String   @default("PENDING")
  attempts            Int      @default(0)
  nextAttemptAt       DateTime @default(now())
  lockedAt            DateTime?
  providerMessageId   String?
  lastErrorCode       String?
  sentAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incident            WorkspaceIncident @relation(fields: [workspaceId, incidentId], references: [workspaceId, id], onDelete: Cascade)
  recipient           User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, incidentId, recipientUserId, incidentOccurrence, eventType])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@index([providerMessageId])
}


model SocialAnalyticsRetry {
  id             String   @id @default(cuid())
  workspaceId    String
  provider       String
  subjectType    String
  subjectId      String
  reportDate     DateTime @db.Date
  status         String   @default("PENDING")
  attemptCount   Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lockedAt       DateTime?
  lastErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, provider, subjectType, subjectId, reportDate])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, status, nextAttemptAt])
}
