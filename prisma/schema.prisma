generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum BrandStatus {
  ACTIVE
  ARCHIVED
}
enum SocialProvider {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
  SNAPCHAT
  REDDIT
  TELEGRAM
}
enum ContentType {
  POST
  ARTICLE
  VIDEO
  IMAGE
  CAROUSEL
  STORY
  SHORT_FORM_VIDEO
}

enum ContentWorkflowStatus {
  IDEA
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum PostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}
enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum WorkspaceNotificationType {
  CONTENT_REVIEW_ASSIGNED
  CONTENT_REVIEW_COMPLETED
  CONTENT_CHANGES_REQUESTED
  SOCIAL_INCIDENT
  SOCIAL_INCIDENT_RESOLVED
  SOCIAL_INCIDENT_ESCALATED
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

model User {
  id           String                @id @default(cuid())
  name         String?
  email        String                @unique
  passwordHash String
  image        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  activityLogs ActivityLog[]
  authoredContentPosts ContentPost[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  assignedContentReviews ContentReviewAssignment[] @relation("ContentReviewAssignee")
  createdContentReviews ContentReviewAssignment[] @relation("ContentReviewAssigner")
  workspaceNotifications WorkspaceNotification[]
  notificationPreferences WorkspaceNotificationPreference[]
  contentReviewEmailDeliveries ContentReviewEmailDelivery[]
  contentReviewEmailDigests ContentReviewEmailDigest[]
  socialIncidentEmailDeliveries WorkspaceIncidentEmailDelivery[]
  aiGenerations AIGeneration[]
}

model Workspace {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  WorkspaceMembership[]
  brands       Brand[]
  campaigns    Campaign[]
  tasks        Task[]
  integrations Integration[]
  automations  Automation[]
  activityLogs ActivityLog[]
  invitations  WorkspaceInvitation[]
  automationAlertPolicy AutomationAlertPolicy?
  automationAlertEvents AutomationAlertEvent[]
  mediaAssets MediaAsset[]
  mediaFolders MediaFolder[]
  contentReviewAssignments ContentReviewAssignment[]
  notifications WorkspaceNotification[]
  contentReviewEmailDeliveries ContentReviewEmailDelivery[]
  contentReviewEmailDigests ContentReviewEmailDigest[]
  notificationPreferences WorkspaceNotificationPreference[]
  incidents WorkspaceIncident[]
  socialIncidentEmailDeliveries WorkspaceIncidentEmailDelivery[]
  socialAnalyticsRetries SocialAnalyticsRetry[]
  aiSettings WorkspaceAISettings?
  aiUsage WorkspaceAIUsage[]
  aiGenerations AIGeneration[]
  websites Website[]
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  @@index([workspaceId, email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Brand {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  websiteUrl     String?
  status         BrandStatus    @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]
  posts          ContentPost[]
  campaigns      Campaign[]
  mediaAssets    MediaAsset[]
  mediaFolders   MediaFolder[]
  aiGenerations AIGeneration[]
  industry       String?
  targetAudience String? @db.Text
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

model SocialAccount {
  id             String         @id @default(cuid())
  workspaceId    String
  brandId        String
  provider       SocialProvider
  providerUserId String?
  accountName    String
  credentialsEncrypted String?   @db.Text
  status         String         @default("DISCONNECTED")
  scopes         String[]       @default([])
  tokenExpiresAt DateTime?
  connectedAt    DateTime?
  lastValidatedAt DateTime?
  lastErrorCode  String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  brand          Brand          @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  publishTargets SocialPostTarget[]
  campaignLinks CampaignSocialAccount[]
  pinterestAnalyticsSnapshots PinterestAnalyticsSnapshot[]
  metaAnalyticsSnapshots MetaAnalyticsSnapshot[]
  linkedinAnalyticsSnapshots LinkedInAnalyticsSnapshot[]
  tikTokAnalyticsSnapshots TikTokAnalyticsSnapshot[]
  youTubeAnalyticsSnapshots YouTubeAnalyticsSnapshot[]
  xAnalyticsSnapshots XAnalyticsSnapshot[]
  incidents WorkspaceIncident[]
  @@unique([workspaceId, provider, providerUserId])
  @@unique([workspaceId, id])
  @@index([workspaceId, brandId, provider])
  @@index([workspaceId, provider, status])
}

model ContentPost {
  id          String     @id @default(cuid())
  workspaceId String
  brandId     String
  title       String?
  body        String
  status      PostStatus @default(DRAFT)
  contentType ContentType @default(POST)
  workflowStatus ContentWorkflowStatus @default(DRAFT)
  category    String?
  tags        String[] @default([])
  campaignId  String?
  authorId    String?
  archivedAt  DateTime?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brand       Brand      @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  campaign    Campaign?  @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Restrict)
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishTargets SocialPostTarget[]
  mediaAssets ContentPostMedia[]
  revisions ContentPostRevision[]
  reviewAssignments ContentReviewAssignment[]
  @@unique([workspaceId, id])
  @@index([workspaceId, brandId, status, scheduledAt])
  @@index([workspaceId, workflowStatus, createdAt])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, archivedAt, updatedAt])
}

model ContentPostRevision {
  id            String      @id @default(cuid())
  workspaceId   String
  contentPostId String
  title         String?
  body          String
  version       Int
  changeReason  String?
  createdById   String?
  createdAt     DateTime    @default(now())
  contentPost   ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([contentPostId, version])
  @@index([workspaceId, contentPostId, createdAt])
}

model ContentReviewAssignment {
  id             String              @id @default(cuid())
  workspaceId    String
  contentPostId  String
  reviewerUserId String
  assignedById   String
  status         ContentReviewStatus @default(PENDING)
  feedback       String?             @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPost    ContentPost         @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  reviewer       User                @relation("ContentReviewAssignee", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  assignedBy     User                @relation("ContentReviewAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  @@unique([workspaceId, contentPostId, reviewerUserId], map: "ContentReviewAssignment_workspaceId_contentPostId_reviewerUserI")
  @@unique([workspaceId, id])
  @@index([workspaceId, reviewerUserId, status, updatedAt], map: "ContentReviewAssignment_workspaceId_reviewerUserId_status_updat")
  @@index([workspaceId, contentPostId, status])
  emailDeliveries ContentReviewEmailDelivery[]
}

model WorkspaceNotification {
  id          String                    @id @default(cuid())
  workspaceId String
  userId      String
  type        WorkspaceNotificationType
  title       String
  message     String                    @db.Text
  href        String
  readAt      DateTime?
  createdAt   DateTime                  @default(now())
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([workspaceId, userId, readAt, createdAt])
}

model SocialPostTarget {
  id             String   @id @default(cuid())
  workspaceId    String
  contentPostId  String
  socialAccountId String
  provider       SocialProvider
  status         String   @default("DRAFT")
  providerPostId String?
  providerContainerId String?
  uploadSessionEncrypted String? @db.Text
  uploadOffset BigInt?
  uploadTotalBytes BigInt?
  uploadMetadata Json?
  processingStartedAt DateTime?
  nextCheckAt DateTime?
  errorCode      String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contentPost    ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  socialAccount  SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  attempts       SocialPublishAttempt[]
  incidents WorkspaceIncident[]
  pinterestAnalyticsSnapshots PinterestPinAnalyticsSnapshot[]
  metaAnalyticsSnapshots MetaAnalyticsSnapshot[]
  linkedinAnalyticsSnapshots LinkedInAnalyticsSnapshot[]
  tikTokAnalyticsSnapshots TikTokAnalyticsSnapshot[]
  youTubeAnalyticsSnapshots YouTubeAnalyticsSnapshot[]
  xAnalyticsSnapshots XAnalyticsSnapshot[]
  @@unique([workspaceId, id])
  @@unique([contentPostId, socialAccountId])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, socialAccountId, status])
  @@index([provider, status, nextCheckAt])
  @@index([workspaceId, provider, status, nextCheckAt])
}

model SocialPublishAttempt {
  id             String   @id @default(cuid())
  workspaceId    String
  targetId       String
  attemptNumber  Int
  idempotencyKey String   @unique
  status         String
  providerPostId String?
  errorCode      String?
  httpStatus     Int?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  target         SocialPostTarget @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([targetId, attemptNumber])
  @@index([workspaceId, startedAt])
}

model MediaAsset {
  id               String           @id @default(cuid())
  workspaceId      String
  brandId          String?
  createdById      String
  storageProvider  String           @default("SUPABASE")
  bucket           String
  objectPath       String
  url              String?          @db.Text
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  checksumSha256   String?
  width            Int?
  height           Int?
  durationMs       Int?
  folderId         String?
  tags             String[]          @default([])
  altText          String?
  status           MediaAssetStatus @default(PENDING)
  uploadedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand?           @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Cascade)
  folder           MediaFolder?     @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Restrict)
  postAttachments ContentPostMedia[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, objectPath])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, brandId, createdAt])
  @@index([workspaceId, folderId, createdAt])
}

model ContentPostMedia {
  id            String      @id @default(cuid())
  workspaceId   String
  contentPostId String
  mediaAssetId  String
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  contentPost   ContentPost @relation(fields: [workspaceId, contentPostId], references: [workspaceId, id], onDelete: Cascade)
  mediaAsset    MediaAsset  @relation(fields: [workspaceId, mediaAssetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, contentPostId, mediaAssetId])
  @@unique([workspaceId, contentPostId, position])
  @@index([workspaceId, mediaAssetId])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  objective   String?
  description String?        @db.Text
  budget      Decimal?       @db.Decimal(12, 2)
  targetAudience String?     @db.Text
  status      CampaignStatus @default(PLANNING)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?         @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  contents    ContentPost[]
  socialAccounts CampaignSocialAccount[]
  aiGenerations AIGeneration[]
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

model MediaFolder {
  id          String       @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [workspaceId, brandId], references: [workspaceId, id], onDelete: Restrict)
  assets      MediaAsset[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, brandId, name])
  @@index([workspaceId, createdAt])
}

model CampaignSocialAccount {
  id              String        @id @default(cuid())
  workspaceId     String
  campaignId      String
  socialAccountId String
  createdAt       DateTime      @default(now())
  campaign        Campaign      @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, campaignId, socialAccountId], map: "CampaignSocialAccount_workspaceId_campaignId_socialAccountId_ke")
  @@index([workspaceId, socialAccountId])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  name        String
  status      String    @default("DISCONNECTED")
  credentialsEncrypted String? @db.Text
  lastValidatedAt DateTime?
  lastExecutionSyncAt DateTime?
  lastExecutionSyncCursor String? @db.Text
  lastErrorAt DateTime?
  lastErrorCode String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationAlertEvents AutomationAlertEvent[]
  automationAlertDeliveries AutomationAlertDelivery[]
  resendWebhookEvents ResendWebhookEvent[]
  n8nExecutionSnapshots N8nExecutionSnapshot[]
  @@unique([workspaceId, provider])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, updatedAt])
  @@index([provider, status, lastExecutionSyncAt])
}

model N8nExecutionSnapshot {
  id            String      @id @default(cuid())
  workspaceId   String
  integrationId String
  executionId   String
  workflowId    String
  status        String
  mode          String
  startedAt     DateTime?
  stoppedAt     DateTime?
  waitTill      DateTime?
  retryOf       String?
  retrySuccessId String?
  syncedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  integration   Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, integrationId, executionId])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, integrationId, status, startedAt], map: "N8nExecutionSnapshot_workspaceId_integrationId_status_startedAt")
  @@index([workspaceId, workflowId, startedAt])
}

model Automation {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  enabled     Boolean   @default(false)
  definition  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, enabled])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  description String?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, dueAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
}


model AutomationAlertPolicy {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  enabled               Boolean   @default(true)
  failureCountThreshold Int       @default(3)
  failureRateThreshold  Float     @default(10)
  lookbackMinutes       Int       @default(1440)
  cooldownMinutes       Int       @default(60)
  emailNotificationsEnabled Boolean @default(false)
  notificationEmail     String?
  lastEvaluatedAt       DateTime?
  lastEscalationAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([enabled, lastEvaluatedAt])
  @@index([enabled, lastEscalationAt, createdAt], map: "automation_alert_policy_escalation_idx")
}

model AutomationAlertEvent {
  id                String    @id @default(cuid())
  workspaceId       String
  integrationId     String
  provider          String    @default("n8n")
  alertType         String
  severity          String    @default("WARNING")
  dedupeKey         String
  message           String
  observedCount     Int
  observedRate      Float
  sampleSize        Int
  status            String    @default("OPEN")
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  lastNotifiedAt    DateTime?
  escalationRecipientCursor String?
  escalatedAt       DateTime?
  resolvedAt        DateTime?
  resolutionMessage String?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  deliveries        AutomationAlertDelivery[]
  @@unique([workspaceId, dedupeKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, status, lastNotifiedAt, escalatedAt, createdAt], map: "automation_alert_escalation_due_idx")
  @@index([workspaceId, integrationId, createdAt])
  @@index([workspaceId, integrationId, status])
}


model AutomationAlertDelivery {
  id                String   @id @default(cuid())
  workspaceId       String
  alertEventId      String
  integrationId     String
  channel           String   @default("EMAIL")
  recipient         String
  status            String   @default("PENDING")
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastProviderEventAt DateTime?
  lastErrorCode     String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  alertEvent        AutomationAlertEvent @relation(fields: [workspaceId, alertEventId], references: [workspaceId, id], onDelete: Cascade)
  attemptRecords    AutomationAlertDeliveryAttempt[]
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, id])
  @@unique([workspaceId, alertEventId, channel, recipient], map: "AutomationAlertDelivery_workspaceId_alertEventId_channel_recipi")
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@index([providerMessageId])
}

model ResendWebhookEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  integrationId   String
  providerEventId String
  eventType       String
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  integration     Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([integrationId, providerEventId])
  @@index([workspaceId, receivedAt])
}

model AutomationAlertDeliveryAttempt {
  id                String   @id @default(cuid())
  workspaceId       String
  deliveryId        String
  attemptNumber     Int
  status            String
  providerMessageId String?
  errorCode         String?
  httpStatus        Int?
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  delivery          AutomationAlertDelivery @relation(fields: [workspaceId, deliveryId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([deliveryId, attemptNumber])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, deliveryId, attemptNumber], map: "AutomationAlertDeliveryAttempt_workspaceId_deliveryId_attemptNu")
}


model PinterestAnalyticsSnapshot {
  id              String        @id @default(cuid())
  workspaceId     String
  socialAccountId String
  reportDate      DateTime      @db.Date
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  metrics         Json
  rawResponse     Json
  fetchedAt       DateTime      @default(now())
  socialAccount   SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, reportDate], map: "PinterestAnalyticsSnapshot_workspaceId_socialAccountId_reportDa")
  @@index([workspaceId, reportDate])
  @@index([workspaceId, socialAccountId, fetchedAt], map: "PinterestAnalyticsSnapshot_workspaceId_socialAccountId_fetchedA")
}


model PinterestPinAnalyticsSnapshot {
  id              String          @id @default(cuid())
  workspaceId     String
  targetId        String
  pinId           String
  reportDate      DateTime        @db.Date
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  metrics         Json
  rawResponse     Json
  fetchedAt       DateTime        @default(now())
  target          SocialPostTarget @relation(fields: [workspaceId, targetId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, targetId, reportDate], map: "PinterestPinAnalyticsSnapshot_workspaceId_targetId_reportDate_k")
  @@index([workspaceId, reportDate])
  @@index([workspaceId, targetId, fetchedAt], map: "PinterestPinAnalyticsSnapshot_workspaceId_targetId_fetchedAt_id")
}


model MetaAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
  target SocialPostTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, socialAccountId, subjectType, subjectId, reportDate], map: "meta_analytics_subject_report_uq")
  @@index([workspaceId, reportDate], map: "meta_analytics_workspace_date_idx")
  @@index([workspaceId, socialAccountId, subjectType, fetchedAt], map: "meta_analytics_account_type_fetched_idx")
  @@index([targetId], map: "meta_analytics_target_idx")
}


model LinkedInAnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  socialAccountId String
  subjectType String
  subjectId String
  targetId String?
  reportDate DateTime @db.Date
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  metrics Json
  rawResponse Json
  fetchedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)
